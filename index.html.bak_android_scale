<!DOCTYPE html>
<html>
<head>
<style>
  /* Detect Android */
  body.android * {
    font-size: 1.25rem !important;
  }

  /* Input groter */
  body.android input[type="text"] {
    height: 60px !important;
    font-size: 1.3rem !important;
    padding: 12px !important;
  }

  /* Buttons groter */
  body.android button {
    font-size: 1.2rem !important;
    padding: 14px 24px !important;
  }

  /* Tabs winkel (Colruyt/Lidl etc) */
  body.android .tab-button {
    font-size: 1.2rem !important;
    padding: 10px 18px !important;
  }

  /* Alles een beetje meer ruimte */
  body.android .container, body.android .content {
    padding: 20px !important;
  }
</style>

  <base href="./">

  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="SmartShopList PWA">

  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="SmartShopList">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, 
user-scalable=no">

  <title>SmartShopList</title>

  <link rel="manifest" href="manifest.json">
<style>
/* Android = scherm smaller dan 600px */
@media screen and (max-width: 600px) {

  /* Vergroot lettertypes */
  body {
    font-size: 22px !important;
    line-height: 1.4 !important;
  }

  /* Input groter */
  input, textarea {
    font-size: 22px !important;
    padding: 14px !important;
  }

  /* Buttons groter */
  button {
    font-size: 22px !important;
    padding: 14px 18px !important;
  }

  /* Tab-knoppen groter */
  .tab-button, .store-btn {
    font-size: 22px !important;
    padding: 10px 16px !important;
  }

  /* Lijsten en items */
  .item-row {
    font-size: 22px !important;
    padding: 16px !important;
  }
}
</style>


  <!-- Icons -->
  <link rel="apple-touch-icon" href="icons/icon_192.png">
  <link rel="icon" type="image/png" href="icons/icon_192.png">

  <!-- Flutter loader -->
  <script defer src="flutter.js"></script>
</head>
<script>
  if (/Android/i.test(navigator.userAgent)) {
    document.body.classList.add('android');
  }
</script>

<body id="testbody">
<script>
  console.log("USERAGENT:", navigator.userAgent);

  if (/Android/i.test(navigator.userAgent)) {
    console.log("ANDROID DETECTED!");
    document.body.classList.add('android');
    document.body.style.border = "10px solid red";
  } else {
    console.log("GEEN ANDROID…");
  }
</script>

  <script>
    window.addEventListener('load', function(ev) {
      _flutter.loader.loadEntrypoint({
        serviceWorker: {
          serviceWorkerVersion: 1,
        }
      }).then(function(engineInitializer) {
        return engineInitializer.initializeEngine();
      }).then(function(appRunner) {
        return appRunner.runApp();
      });
    });
  </script>
</body>
</html>

